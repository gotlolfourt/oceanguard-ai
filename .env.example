# Environment Variables - Copy to .env and fill in values

# Application
ENVIRONMENT=development
DEBUG=true

# Database
DB_USER=oceanguard
DB_PASSWORD=oceanguard_dev_pass
DB_NAME=oceanguard_db
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql://oceanguard:oceanguard_dev_pass@postgres:5432/oceanguard_db

# Redis
REDIS_URL=redis://redis:6379/0

# JWT & Security
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# API
API_HOST=0.0.0.0
API_PORT=8000
API_TITLE=OceanGuard AI API

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File Storage
STORAGE_TYPE=local
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=500

# AI Models
AI_SERVICE_URL=http://ai:8001
MODEL_PATH=/models
YOLO_MODEL_NAME=yolov8n
YOLO_CONFIDENCE_THRESHOLD=0.5
YOLO_IOU_THRESHOLD=0.45

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@oceanguard.com

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
VITE_APP_NAME=OceanGuard AI

# AWS (Optional - for production storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Monitoring (Optional)
SENTRY_DSN=
